<!-- DeviceTemplates/RGBA.xml -->
<DeviceTemplate name="RGBWAUV" category="Allgemein">
  <Description>Ein 6-Kanal RGBWAUV-Gerät</Description>
  <Channels>
    <Channel name="Red"   offset="0" default="0" mergeMode="HTP" />
    <Channel name="Green" offset="1" default="0" mergeMode="HTP" />
    <Channel name="Blue"  offset="2" default="0" mergeMode="HTP" />
    <Channel name="White" offset="3" default="0" mergeMode="HTP" />
    <Channel name="Amber" offset="4" default="0" mergeMode="HTP" />
    <Channel name="UV"    offset="5" default="0" mergeMode="HTP" />
  </Channels>
</DeviceTemplate>
