<!-- DeviceTemplates/RGBA.xml -->
<DeviceTemplate name="RGBWAUV" category="Allgemein">
  <Description>Ein 6-Kanal RGBWAUV-Gerät</Description>
  <ControllType type="3">
  <Channels>
    <Channel name="Red"   text="Rot" offset="0" default="0" mergeMode="HTP" />
    <Channel name="Green" text="Grün" offset="1" default="0" mergeMode="HTP" />
    <Channel name="Blue"  text="Blau" offset="2" default="0" mergeMode="HTP" />
    <Channel name="White" text="Weiß" offset="3" default="0" mergeMode="HTP" />
    <Channel name="Amber" text="Bernstein" offset="4" default="0" mergeMode="HTP" />
    <Channel name="UV"    text="UV" offset="5" default="0" mergeMode="HTP" />
  </Channels>
</DeviceTemplate>
