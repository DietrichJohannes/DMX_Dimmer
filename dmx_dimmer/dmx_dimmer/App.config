<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
  </configSections>
  <appSettings>
    <!-- Dein Gerätevorlagen-Ordner -->
    <add key="DeviceTemplatesPath" value="G:\Programme\Projekte\DMX Dimmer\files\devices" />
    
    <!-- ArtNet-Node IP -->
    <add key="ArtNetIP" value="192.168.2.255" />

    <!-- Nur Senden bei Dateinänderung -->
    <add key="SendOnlyWhenDirty" value="true" />


	<!-- DMX Frame rate pro Sekunde -->
	<add key="DMXFPS" value="30" />
	  
    <!--"Passwort für Sperre"-->
	<add key="Password" value=""/>
	  
	<!--"Passwort für Webserver"-->
	<add key="ServerPassword" value=""/>

	<!--"Port für Webserver"-->
	<add key="WebserverPort" value="8080"/>
  </appSettings>
</configuration>
